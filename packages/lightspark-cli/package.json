{
  "name": "@lightsparkdev/lightspark-cli",
  "version": "0.1.20",
  "description": "CLI for the Lightspark JS sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lightsparkdev/js-sdk.git",
    "directory": "packages/lightspark-cli"
  },
  "main": "./dist/index.js",
  "bin": {
    "lightspark": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "clean": "rm -rf dist",
    "cli:watch": "nodemon --watch 'src/**/*.ts' --exec 'node --loader ts-node/esm' src/index.ts",
    "cli": "node --loader ts-node/esm src/index.ts",
    "format:fix": "bun fmt src --no-script",
    "format": "bun fmt src --check --no-script",
    "lint:fix": "eslint --fix .",
    "lint:watch": "nodemon --watch ./src --ext ts,tsx,js,cjs,mjs --exec \"eslint ./src --color\"",
    "lint": "eslint .",
    "local": "sudo npm i -g && lightspark",
    "refresh": "rm -rf ./node_modules ./package-lock.json && yarn install",
    "start:windows": "nodemon --watch 'src/**/*.ts' --exec \"npx ts-node\" src/index.ts",
    "test": "./test.sh",
    "types": "tsc",
    "types:watch": "tsc-absolute --watch"
  },
  "type": "module",
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@lightsparkdev/eslint-config": "*",
    "@lightsparkdev/tsconfig": "0.0.1",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.2.5",
    "@types/qrcode-terminal": "^0.12.0",
    "@types/secp256k1": "^4.0.3",
    "bun": "1.4.4",
    "eslint": "^10.0.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsc-absolute": "^1.0.1",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@inquirer/prompts": "^1.1.3",
    "@lightsparkdev/core": "1.5.3",
    "@lightsparkdev/crypto-wasm": "0.1.27",
    "@lightsparkdev/lightspark-sdk": "1.9.20",
    "@noble/curves": "^2.4.0",
    "commander": "^11.0.0",
    "dayjs": "^1.11.7",
    "dotenv": "^16.3.1",
    "jose": "^4.15.5",
    "jsonwebtoken": "^9.0.1",
    "qrcode-terminal": "^0.12.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  }
}
